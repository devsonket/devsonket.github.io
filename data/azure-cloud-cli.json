                    {
                        "definition": "Key Vault-এর Secret-গুলোর তালিকা দেখা",
                        "code": "az keyvault secret list --vault-name myUniqueKeyVault123 --output table"
                    },
                    {
                        "definition": "নির্দিষ্ট Secret ডিলিট করা",
                        "code": "az keyvault secret delete --vault-name myUniqueKeyVault123 --name mySecret"
                    },
                    {
                        "definition": "Key Vault-এর তালিকা দেখা",
                        "code": "az keyvault list --resource-group myResourceGroup --output table"
                    }
                ]

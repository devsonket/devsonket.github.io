                },
                {
                    "definition": "কমান্ড লাইন দিয়ে লগিন ",
                    "code": "az login -u myemail@address.com"
                },
                {
                    "definition": "একাউন্ট লিস্ট করা ",
                    "code": "az account list"
                },
                {
                    "definition": "সাবস্ক্রিপশন সেট করা ",
                    "code": "az account set --subscription"
                }
            ]
        },
        {

                    },
                    {
                        "definition": "Container-এর লগ দেখা",
                        "code": "az container logs --resource-group myResourceGroup --name myContainer"
                    },
                    {
                        "definition": "Container Instance-এর বিস্তারিত তথ্য দেখা",
                        "code": "az container show --resource-group myResourceGroup --name myContainer"
                    },
                    {
                        "definition": "Container Instance ডিলিট করা",
                        "code": "az container delete --resource-group myResourceGroup --name myContainer --yes"
                    }
                ]
            },
            {
                "title": "Azure Key Vault ও Secret ম্যানেজমেন্ট",
                "items": [
                    {
                        "definition": "নতুন Key Vault তৈরি করা",
                        "code": "az keyvault create --name myUniqueKeyVault123 --resource-group myResourceGroup --location eastus"
                    },
                    {
                        "definition": "Key Vault-এ Secret সংরক্ষণ করা",
